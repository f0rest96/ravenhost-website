---
const currentYear = new Date().getFullYear();

const links = {
  Services: [
    { label: 'Game Server Hosting', href: '#game-servers' },
    { label: 'Virtual Private Servers', href: '#vps' },
    { label: 'Dedicated Infrastructure', href: '#infrastructure' },
    { label: 'Pricing', href: '#pricing' },
  ],
  Platform: [
    { label: 'Client Panel', href: 'https://panel.ravenhost.org', external: true },
    { label: 'Features', href: '#features' },
    { label: 'Why RavenHost', href: '#why-us' },
    { label: 'FAQ', href: '#faq' },
  ],
  Support: [
    { label: 'Open a Ticket', href: 'https://panel.ravenhost.org', external: true },
    { label: 'Contact Us', href: '#contact' },
    { label: 'System Status', href: '#', external: true },
    { label: 'Documentation', href: '#', external: true },
  ],
  Legal: [
    { label: 'Terms of Service', href: '#' },
    { label: 'Privacy Policy', href: '#' },
    { label: 'Acceptable Use Policy', href: '#' },
    { label: 'Cookie Policy', href: '#' },
  ],
};
---

<footer class="relative border-t border-slate-800/70 bg-slate-950">

  <!-- Top gradient bar -->
  <div class="h-px w-full bg-gradient-to-r from-transparent via-brand-500/40 to-transparent" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">

    <!-- Top row: brand + links -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 mb-14">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-3 mb-5" aria-label="RavenHost home">
          <img
            src="/assets/logo-dark-theme.png"
            alt="RavenHost"
            class="h-10 w-auto"
            width="40" height="53"
            loading="lazy"
            decoding="async"
          />
          <span class="font-bold text-lg text-white">RavenHost</span>
        </a>
        <p class="text-sm text-slate-500 leading-relaxed mb-5">
          Premium hosting for games, VPS, and infrastructure.
          Built for uptime, built for speed.
        </p>
        <!-- Social placeholders -->
        <div class="flex items-center gap-3">
          <a href="#" aria-label="RavenHost on Discord (coming soon)"
            class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center text-slate-400 hover:text-white transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.03.055a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03Z"/>
            </svg>
          </a>
          <a href="#" aria-label="RavenHost on X/Twitter (coming soon)"
            class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center text-slate-400 hover:text-white transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href="#" aria-label="RavenHost on GitHub (coming soon)"
            class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center text-slate-400 hover:text-white transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      {Object.entries(links).map(([heading, items]) => (
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-4">{heading}</h3>
          <ul class="space-y-2.5">
            {items.map(({ label, href, external }) => (
              <li>
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  class="text-sm text-slate-400 hover:text-white transition-colors"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Divider -->
    <div class="h-px bg-slate-800/70 mb-8" aria-hidden="true" />

    <!-- Bottom row -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-600">
      <p>&copy; {currentYear} RavenHost. All rights reserved.</p>
      <div class="flex items-center gap-1.5">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(52,211,153,0.7)]" aria-label="All systems operational" />
        <span>All systems operational</span>
        <span class="mx-2 opacity-30">·</span>
        <a href="https://panel.ravenhost.org" target="_blank" rel="noopener noreferrer" class="hover:text-slate-400 transition-colors">
          panel.ravenhost.org
        </a>
      </div>
    </div>
  </div>
</footer>
