---
---

<section id="contact" class="relative py-24 lg:py-32 overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-500/30 to-transparent" aria-hidden="true" />

  <!-- Glow blob -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
    style="background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(26,111,255,0.08) 0%, transparent 70%);"
  />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">

    <!-- Eyebrow -->
    <div class="section-label justify-center mb-4">
      <span class="inline-block w-2 h-2 rounded-full bg-brand-400" aria-hidden="true" />
      Get in Touch
    </div>

    <h2 class="section-title text-4xl md:text-5xl mb-5">
      Ready to Get Started?
    </h2>
    <p class="section-subtitle mx-auto mb-12 max-w-lg">
      Have questions before you order? Our team is ready to help you pick the
      right plan, answer technical questions, or set up a custom solution.
    </p>

    <!-- CTA cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-12">

      <!-- Panel / ticket -->
      <a
        href="https://panel.ravenhost.org"
        target="_blank"
        rel="noopener noreferrer"
        class="card-hover p-6 flex flex-col items-center gap-3 text-center group"
      >
        <div class="w-12 h-12 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 group-hover:bg-brand-500/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 0 1-.923 1.785A5.969 5.969 0 0 0 6 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337Z" />
          </svg>
        </div>
        <div>
          <p class="font-semibold text-white mb-1 text-sm">Open a Ticket</p>
          <p class="text-xs text-slate-500">Support via the client panel</p>
        </div>
        <span class="text-xs font-medium text-brand-400 group-hover:text-brand-300 transition-colors">
          panel.ravenhost.org →
        </span>
      </a>

      <!-- Email -->
      <a
        href="mailto:support@ravenhost.org"
        class="card-hover p-6 flex flex-col items-center gap-3 text-center group"
      >
        <div class="w-12 h-12 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 group-hover:bg-brand-500/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
        </div>
        <div>
          <p class="font-semibold text-white mb-1 text-sm">Email Us</p>
          <p class="text-xs text-slate-500">For general enquiries</p>
        </div>
        <span class="text-xs font-medium text-brand-400 group-hover:text-brand-300 transition-colors">
          support@ravenhost.org →
        </span>
      </a>

      <!-- Discord (placeholder) -->
      <a
        href="#"
        class="card-hover p-6 flex flex-col items-center gap-3 text-center group"
        aria-label="Join RavenHost Discord (link coming soon)"
      >
        <div class="w-12 h-12 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 group-hover:bg-brand-500/20 transition-colors">
          <!-- Discord icon (simplified SVG) -->
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.03.055a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03ZM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-white mb-1 text-sm">Discord Community</p>
          <p class="text-xs text-slate-500">Chat with the community &amp; team</p>
        </div>
        <span class="text-xs font-medium text-slate-500">
          Coming soon
        </span>
      </a>
    </div>

    <!-- Big CTA -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="https://panel.ravenhost.org"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-base px-10 py-4"
      >
        Create an Account
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
      <a href="#services" class="btn-ghost text-base px-10 py-4">
        Browse Services
      </a>
    </div>
  </div>
</section>
