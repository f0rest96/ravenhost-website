---
const services = [
  {
    id: 'game-servers',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z" /></svg>`,
    title: 'Game Server Hosting',
    description: 'Minecraft, Rust, ARK, Valheim, and more. Low-latency nodes purpose-built for gaming with instant mod installation and one-click updates.',
    features: ['Sub-10ms ping optimization', 'Instant mod & plugin support', 'Automatic backups', 'DDoS mitigation'],
    cta: 'Deploy a Game Server',
    accent: 'from-blue-600/20 to-cyan-600/10',
    border: 'hover:border-blue-500/40',
    glow: 'hover:shadow-blue-500/10',
  },
  {
    id: 'vps',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.737 5.1a3.375 3.375 0 0 1 2.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 0 1 .9 2.7m0 0a3 3 0 0 1-3 3m0 3h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Zm-3 6h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Z" /></svg>`,
    title: 'Virtual Private Servers',
    description: 'Full root access, KVM virtualization, and dedicated resources. Run any workload — web apps, databases, bots, or private game infrastructure.',
    features: ['KVM-based isolation', 'NVMe SSD storage', 'IPv4 + IPv6 included', 'Scalable CPU & RAM'],
    cta: 'Configure a VPS',
    accent: 'from-indigo-600/20 to-blue-600/10',
    border: 'hover:border-indigo-500/40',
    glow: 'hover:shadow-indigo-500/10',
    featured: true,
  },
  {
    id: 'infrastructure',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z" /></svg>`,
    title: 'Dedicated Infrastructure',
    description: 'Custom hardware allocations and bare-metal options for teams that need guaranteed resources, isolated networking, and enterprise reliability.',
    features: ['Bare-metal options', 'Custom network configs', 'SLA-backed resources', 'Priority support'],
    cta: 'Talk to Sales',
    accent: 'from-slate-700/30 to-slate-800/10',
    border: 'hover:border-slate-600/40',
    glow: 'hover:shadow-slate-500/10',
  },
];
---

<section id="services" class="relative py-24 lg:py-32">
  <!-- Subtle top fade from hero -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-500/30 to-transparent" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-16 reveal">
      <div class="section-label justify-center">
        <span class="inline-block w-2 h-2 rounded-full bg-brand-400" aria-hidden="true" />
        What We Offer
      </div>
      <h2 class="section-title text-center">Hosting Built for Every Need</h2>
      <p class="section-subtitle mt-4 mx-auto text-center">
        From single game servers to full infrastructure — we have a plan that fits.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {services.map((svc) => (
        <div
          id={svc.id}
          class={`card-hover p-7 flex flex-col gap-5 relative overflow-hidden reveal ${svc.featured ? 'ring-1 ring-brand-500/30' : ''}`}
        >
          <!-- Card gradient bg tint -->
          <div class={`absolute inset-0 bg-gradient-to-br ${svc.accent} pointer-events-none`} aria-hidden="true" />

          {svc.featured && (
            <div class="absolute top-4 right-4">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-500/20 text-brand-300 border border-brand-500/30">
                Most Popular
              </span>
            </div>
          )}

          <!-- Icon -->
          <div class="relative w-12 h-12 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 shrink-0">
            <Fragment set:html={svc.icon} />
          </div>

          <!-- Text -->
          <div class="flex-1">
            <h3 class="text-xl font-bold text-white mb-2">{svc.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-5">{svc.description}</p>

            <!-- Feature bullets -->
            <ul class="space-y-2">
              {svc.features.map((feat) => (
                <li class="flex items-center gap-2.5 text-sm text-slate-300">
                  <svg class="w-4 h-4 text-brand-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  {feat}
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA -->
          <a
            href="#contact"
            class={`mt-auto relative inline-flex items-center justify-center gap-2 w-full py-2.5 rounded-lg text-sm font-semibold border transition-all duration-200
              ${svc.featured
                ? 'bg-brand-500 hover:bg-brand-400 border-brand-500 text-white hover:shadow-brand'
                : 'bg-transparent border-slate-700 hover:border-brand-500/50 text-slate-300 hover:text-white hover:bg-slate-800/50'
              }`}
          >
            {svc.cta}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
