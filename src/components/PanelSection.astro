---
---

<section id="panel" class="relative py-24 lg:py-32 overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-500/30 to-transparent" aria-hidden="true" />

  <!-- Glow accents -->
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full pointer-events-none"
    style="background: radial-gradient(circle, rgba(26,111,255,0.07) 0%, transparent 70%);"
    aria-hidden="true"
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center">

      <!-- Left: dashboard mockup -->
      <div class="w-full lg:w-3/5 reveal order-2 lg:order-1">
        <div class="relative rounded-2xl overflow-hidden border border-slate-700/60 shadow-2xl shadow-brand-500/10 group">

          <!-- Glowing border top -->
          <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-500/60 to-transparent" aria-hidden="true" />

          <!-- Browser chrome -->
          <div class="bg-slate-900 px-4 py-3 flex items-center gap-3 border-b border-slate-800">
            <div class="flex items-center gap-1.5" aria-hidden="true">
              <span class="w-3 h-3 rounded-full bg-slate-700" />
              <span class="w-3 h-3 rounded-full bg-slate-700" />
              <span class="w-3 h-3 rounded-full bg-slate-700" />
            </div>
            <div class="flex-1 mx-3">
              <div class="h-6 bg-slate-800 rounded-md flex items-center px-3 gap-2">
                <svg class="w-3 h-3 text-slate-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
                <span class="text-xs text-slate-500 font-mono">panel.ravenhost.org</span>
              </div>
            </div>
          </div>

          <!-- Dashboard screenshot -->
          <div class="relative overflow-hidden">
            <img
              src="/assets/dashboard.png"
              alt="RavenHost client dashboard — server overview and resource monitoring"
              class="w-full block transition-transform duration-700 group-hover:scale-[1.02]"
              loading="lazy"
              decoding="async"
            />
            <!-- Bottom fade -->
            <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-slate-950 to-transparent" aria-hidden="true" />
          </div>
        </div>
      </div>

      <!-- Right: copy + CTA -->
      <div class="w-full lg:w-2/5 reveal order-1 lg:order-2">
        <div class="section-label">
          <span class="inline-block w-2 h-2 rounded-full bg-brand-400" aria-hidden="true" />
          Client Panel
        </div>
        <h2 class="section-title mb-5">
          Manage Everything<br />
          <span class="glow-text">in One Place</span>
        </h2>
        <p class="text-slate-400 leading-relaxed mb-6">
          Every service you order from RavenHost is managed through a single, clean dashboard.
          Start servers, view live console output, configure files, open support tickets, and manage
          billing — all without needing SSH.
        </p>

        <ul class="space-y-3 mb-8">
          {[
            'Live server console and resource graphs',
            'File manager with drag-and-drop uploads',
            'One-click backups and restore points',
            'Support ticketing integrated directly',
            'Billing, invoices, and plan management',
          ].map((item) => (
            <li class="flex items-start gap-3 text-sm text-slate-300">
              <svg class="w-5 h-5 text-brand-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <a
          href="https://panel.ravenhost.org"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-base px-8 py-4 w-full sm:w-auto justify-center animate-glow-pulse"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0H3" />
          </svg>
          Open the Client Panel
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>

        <p class="mt-3 text-xs text-slate-600">
          New customer? Create your account at panel.ravenhost.org
        </p>
      </div>
    </div>
  </div>
</section>
