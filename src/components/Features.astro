---

<section id="features" class="relative py-24 lg:py-32 bg-slate-950/60">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-700/40 to-transparent" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-16 reveal">
      <div class="section-label justify-center">
        <span class="inline-block w-2 h-2 rounded-full bg-brand-400" aria-hidden="true" />
        Platform Features
      </div>
      <h2 class="section-title text-center mb-4">Everything You Need, Nothing You Don't</h2>
      <p class="section-subtitle text-center mx-auto max-w-xl">
        A focused set of tools built around what hosting customers actually use.
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {features.map((feat, i) => (
        <div
          class="card-hover p-5 flex flex-col gap-3 reveal"
          style={`animation-delay: ${(i % 4) * 0.08}s`}
        >
          <!-- Icon row -->
          <div class="w-10 h-10 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 shrink-0">
            <Fragment set:html={feat.icon} />
          </div>

          <h3 class="font-semibold text-white text-sm">{feat.title}</h3>
          <p class="text-slate-500 text-xs leading-relaxed">{feat.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
