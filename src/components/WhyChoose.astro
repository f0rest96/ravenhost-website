---
const reasons = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" /></svg>`,
    title: 'Blazing Performance',
    description: 'NVMe SSDs, high-frequency CPUs, and low-latency network fabric tuned for real-time workloads.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0H3" /></svg>`,
    title: 'Effortless Management',
    description: 'The RavenHost panel gives you full control over every service - servers, billing, and support - in one clean interface.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>`,
    title: '99.9% Uptime SLA',
    description: 'Redundant networking and proactive monitoring keep your services online when it counts, backed by a real SLA commitment.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>`,
    title: 'Enterprise-Grade Security',
    description: 'Always-on DDoS filtering, isolated virtualization, and hardened infrastructure protect your services and your users.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 0 1-.923 1.785A5.969 5.969 0 0 0 6 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337Z" /></svg>`,
    title: 'Responsive Support',
    description: 'Real humans available around the clock via the panel ticketing system. We aim for first-response under 1 hour.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>`,
    title: 'Modern Control Panel',
    description: 'Built on FeatherPanel - a clean, fast, and extensible dashboard for managing your entire hosting stack without a learning curve.',
  },
];
---

<section id="why-us" class="relative py-24 lg:py-32 bg-slate-950/80">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-700/40 to-transparent" aria-hidden="true" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col lg:flex-row gap-16 lg:gap-24 items-start">

      <!-- Left: sticky header text -->
      <div class="lg:sticky lg:top-28 lg:w-80 shrink-0 reveal">
        <div class="section-label">
          <span class="inline-block w-2 h-2 rounded-full bg-brand-400" aria-hidden="true" />
          Why RavenHost
        </div>
        <h2 class="section-title mb-4">Infrastructure You Can Rely On</h2>
        <p class="section-subtitle text-base">
          We built RavenHost for customers who care about reliability, speed, and simplicity -
          not just the lowest price.
        </p>
        <a href="#services" class="btn-primary mt-8 inline-flex">
          Browse Services
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <!-- Right: reasons grid -->
      <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {reasons.map((r, i) => (
          <div
            class={`card-hover p-6 flex gap-4 items-start reveal`}
            style={`animation-delay: ${i * 0.07}s`}
          >
            <div class="shrink-0 w-11 h-11 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400">
              <Fragment set:html={r.icon} />
            </div>
            <div>
              <h3 class="font-semibold text-white mb-1.5">{r.title}</h3>
              <p class="text-sm text-slate-400 leading-relaxed">{r.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
