---
---

<section
  id="hero"
  class="relative min-h-screen flex items-center pt-16 overflow-hidden"
  aria-label="Hero"
>
  <!-- Deep background -->
  <div class="absolute inset-0 bg-slate-950" aria-hidden="true" />

  <!-- Radial glow behind canvas -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 70% 60% at 70% 50%, rgba(26,111,255,0.13) 0%, transparent 70%);"
  />

  <!-- Background image - very low opacity brand texture -->
  <div class="absolute inset-0 opacity-[0.035] pointer-events-none" aria-hidden="true">
    <img
      src="/assets/background.png"
      alt=""
      class="w-full h-full object-cover object-center"
      aria-hidden="true"
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- Three.js canvas (right half only) -->
  <canvas
    id="hero-canvas"
    class="absolute top-0 right-0 w-1/2 h-full pointer-events-none"
    aria-hidden="true"
  />


  <!-- Hero content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 w-full">
    <div class="max-w-2xl">

      <!-- Eyebrow label -->
      <div class="section-label reveal">
        <span class="inline-block w-2 h-2 rounded-full bg-brand-400 animate-pulse-slow" aria-hidden="true" />
        Premium Hosting Infrastructure
      </div>

      <!-- Headline -->
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-white leading-[1.08] tracking-tight mb-6 reveal" style="animation-delay:0.1s">
        Power Your World.<br />
        <span class="glow-text">Host Without Limits.</span>
      </h1>

      <!-- Sub-copy -->
      <p class="text-lg sm:text-xl text-slate-400 leading-relaxed mb-10 max-w-xl reveal" style="animation-delay:0.2s">
        Game servers, VPS, and infrastructure engineered for performance.
        Deploy in seconds, scale with confidence, manage everything from one panel.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-wrap items-center gap-4 reveal" style="animation-delay:0.3s">
        <a href="#services" class="btn-primary text-base px-8 py-4">
          Get Started
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href="https://panel.ravenhost.org"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost text-base px-8 py-4"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0H3" />
          </svg>
          Client Panel
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 opacity-60" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>

      <!-- Trust badges -->
      <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-slate-500 reveal" style="animation-delay:0.4s">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.8)]" aria-hidden="true" />
          99.9% Uptime SLA
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd" />
          </svg>
          DDoS Protected
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          24/7 Support
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
          </svg>
          Instant Deployment
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-600 animate-bounce" aria-hidden="true">
    <span class="text-xs tracking-widest uppercase">Scroll</span>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25 12 15.75 4.5 8.25" />
    </svg>
  </div>
</section>

<script>
(async () => {
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;

  // Respect reduced motion preference
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  // WebGL availability check
  try {
    const probe = canvas.getContext('webgl2') ?? canvas.getContext('webgl');
    if (!probe) return;
  } catch { return; }

  const THREE = await import('three');

  // ── Scene setup ──────────────────────────────────────────────
  const scene  = new THREE.Scene();
  const width  = canvas.clientWidth;
  const height = canvas.clientHeight;
  const camera = new THREE.PerspectiveCamera(55, width / height, 0.1, 200);
  camera.position.set(0, 0, 9);

  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setSize(width, height, false);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 0);

  // ── Central server rack ───────────────────────────────────────
  const rackGroup = new THREE.Group();
  scene.add(rackGroup);

  // Outer rack frame
  const rackW = 0.9, rackH = 2.6, rackD = 0.55;
  const rackEdges = new THREE.EdgesGeometry(new THREE.BoxGeometry(rackW, rackH, rackD));
  rackGroup.add(new THREE.LineSegments(rackEdges,
    new THREE.LineBasicMaterial({ color: 0x1a6fff, transparent: true, opacity: 0.85 })));

  // Server unit shelves + LED indicators
  const SHELF_COUNT = 7;
  for (let i = 0; i < SHELF_COUNT; i++) {
    const y = -rackH / 2 + 0.28 + i * ((rackH - 0.42) / (SHELF_COUNT - 1));

    // Shelf line across the front face
    const shelfPts = [
      new THREE.Vector3(-rackW / 2 + 0.06, y, rackD / 2 + 0.001),
      new THREE.Vector3( rackW / 2 - 0.06, y, rackD / 2 + 0.001),
    ];
    rackGroup.add(new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(shelfPts),
      new THREE.LineBasicMaterial({ color: i % 2 === 0 ? 0x00d4ff : 0x1a6fff, transparent: true, opacity: 0.45 }),
    ));

    // Green LED dot (right side of each shelf)
    const ledPts = [
      new THREE.Vector3(rackW / 2 - 0.18, y, rackD / 2 + 0.002),
      new THREE.Vector3(rackW / 2 - 0.14, y, rackD / 2 + 0.002),
    ];
    rackGroup.add(new THREE.Line(
      new THREE.BufferGeometry().setFromPoints(ledPts),
      new THREE.LineBasicMaterial({ color: 0x00ff88, transparent: true, opacity: 0.95 }),
    ));
  }

  // ── Orbiting server node boxes ────────────────────────────────
  const NODE_COUNT = 6;
  type OrbNode = {
    group: THREE.Group;
    angle: number;
    speed: number;
    radius: number;
    yBias: number;
    tilt: number;
  };
  const orbitNodes: OrbNode[] = [];

  const NODE_COLORS = [0x1a6fff, 0x00d4ff, 0x3a8fff, 0x1a6fff, 0x00a8ff, 0x00d4ff];

  for (let i = 0; i < NODE_COUNT; i++) {
    const g = new THREE.Group();
    const nw = 0.22 + Math.random() * 0.1;
    const nh = 0.13 + Math.random() * 0.07;
    g.add(new THREE.LineSegments(
      new THREE.EdgesGeometry(new THREE.BoxGeometry(nw, nh, nh * 0.65)),
      new THREE.LineBasicMaterial({ color: NODE_COLORS[i], transparent: true, opacity: 0.9 }),
    ));
    scene.add(g);
    orbitNodes.push({
      group: g,
      angle: (i / NODE_COUNT) * Math.PI * 2,
      speed: 0.11 + Math.random() * 0.09,
      radius: 2.7 + Math.random() * 0.9,
      yBias: (Math.random() - 0.5) * 1.6,
      tilt:  (Math.random() - 0.5) * 0.5,
    });
  }

  // ── Hub-and-spoke connection lines ────────────────────────────
  const spokePositions = new Float32Array(NODE_COUNT * 6);
  const spokeGeo = new THREE.BufferGeometry();
  spokeGeo.setAttribute('position', new THREE.BufferAttribute(spokePositions, 3));
  scene.add(new THREE.LineSegments(spokeGeo,
    new THREE.LineBasicMaterial({ color: 0x1a6fff, transparent: true, opacity: 0.14 })));

  // ── Data-flow particles (travel center → each node) ──────────
  const PPS = 3; // particles per spoke
  const flowTotal = NODE_COUNT * PPS;
  const flowPos = new Float32Array(flowTotal * 3);
  const flowGeo = new THREE.BufferGeometry();
  flowGeo.setAttribute('position', new THREE.BufferAttribute(flowPos, 3));
  scene.add(new THREE.Points(flowGeo,
    new THREE.PointsMaterial({ color: 0x00d4ff, size: 0.07, transparent: true, opacity: 0.95 })));

  // stagger starting positions so they don't all cluster at once
  const flowT = Array.from({ length: flowTotal }, (_, i) => (i % PPS) / PPS);

  // ── Background particle dust ──────────────────────────────────
  const DUST = 220;
  const dustPos = new Float32Array(DUST * 3);
  for (let i = 0; i < DUST; i++) {
    dustPos[i * 3]     = (Math.random() - 0.5) * 22;
    dustPos[i * 3 + 1] = (Math.random() - 0.5) * 14;
    dustPos[i * 3 + 2] = (Math.random() - 0.5) * 10;
  }
  const dustGeo = new THREE.BufferGeometry();
  dustGeo.setAttribute('position', new THREE.BufferAttribute(dustPos, 3));
  scene.add(new THREE.Points(dustGeo,
    new THREE.PointsMaterial({ color: 0x1a3060, size: 0.03, transparent: true, opacity: 0.5 })));

  // ── Mouse parallax ────────────────────────────────────────────
  let targetX = 0, targetY = 0, currentX = 0, currentY = 0;
  window.addEventListener('mousemove', (e: MouseEvent) => {
    targetX = ((e.clientX / window.innerWidth)  - 0.5) * 0.6;
    targetY = ((e.clientY / window.innerHeight) - 0.5) * 0.3;
  }, { passive: true });

  // ── Animation loop ────────────────────────────────────────────
  const flowBuf = flowGeo.attributes.position as THREE.BufferAttribute;
  const spokeBuf = spokeGeo.attributes.position as THREE.BufferAttribute;

  const animate = () => {
    requestAnimationFrame(animate);
    const t = performance.now() * 0.001;

    // Rack slowly rotates
    rackGroup.rotation.y = t * 0.12;

    // Orbit nodes + update spokes + flow particles
    orbitNodes.forEach((node, i) => {
      node.angle += node.speed * 0.008;
      const nx = Math.cos(node.angle) * node.radius;
      const nz = Math.sin(node.angle) * node.radius * 0.5;
      const ny = node.yBias + Math.sin(node.angle * 1.3 + node.tilt) * 0.65;
      node.group.position.set(nx, ny, nz);
      node.group.rotation.y = t * 0.9;

      // Spoke center → node
      spokeBuf.setXYZ(i * 2,     0,  0,  0);
      spokeBuf.setXYZ(i * 2 + 1, nx, ny, nz);

      // Flow particles along spoke
      for (let p = 0; p < PPS; p++) {
        const fi = i * PPS + p;
        flowT[fi] = (flowT[fi] + 0.0045) % 1.0;
        const s = flowT[fi];
        flowBuf.setXYZ(fi, nx * s, ny * s, nz * s);
      }
    });

    spokeBuf.needsUpdate = true;
    flowBuf.needsUpdate  = true;

    // Camera parallax lerp
    currentX += (targetX - currentX) * 0.04;
    currentY += (targetY - currentY) * 0.04;
    camera.position.x = currentX * 1.5;
    camera.position.y = -currentY * 0.8;
    camera.lookAt(0, 0, 0);

    renderer.render(scene, camera);
  };
  animate();

  // ── Resize handler ────────────────────────────────────────────
  const onResize = () => {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h, false);
  };
  window.addEventListener('resize', onResize, { passive: true });
})();
</script>
